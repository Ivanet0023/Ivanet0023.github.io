generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  orders   Order[]
}

model Order {
  id      Int      @id @default(autoincrement())
  userId  Int
  date    String
  total   Float
  status  String
  items   Json
  user    User     @relation(fields: [userId], references: [id])
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  category    String
  img         String
  description String
}
