generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  orders   Order[]
}

model Order {
  id      Int      @id @default(autoincrement())
  userId  Int
  date    String
  total   Float
  status  String
  items   Json
  user    User     @relation(fields: [userId], references: [id])
}
